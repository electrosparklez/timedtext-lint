{
  "name": "timedtext-lint",
  "version": "0.1.0",
  "description": "A CI-friendly linter for SRT and WebVTT subtitle files.",
  "type": "module",
  "bin": {
    "timedtext-lint": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run test && npm run lint && npm run format:check",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "subtitles",
    "captions",
    "srt",
    "webvtt",
    "vtt",
    "linter",
    "accessibility",
    "ci"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electrosparklez/timedtext-lint.git"
  },
  "bugs": {
    "url": "https://github.com/electrosparklez/timedtext-lint/issues"
  },
  "homepage": "https://github.com/electrosparklez/timedtext-lint#readme",
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.0.0"
  }
}
